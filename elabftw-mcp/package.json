{
  "name": "elabftw-mcp",
  "version": "0.1.0",
  "description": "MCP server for uploading content to an elabFTW instance via the official REST API v2",
  "type": "module",
  "bin": {
    "elabftw-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f elabftw-mcp"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "elabftw",
    "eln",
    "upload"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
