# --- elabFTW API (required) ---
# Instance root (no trailing slash; /api/v2 is appended automatically)
ELABFTW_BASE_URL=https://eln.example.org

# API key from elabFTW Settings → API keys (Authorization header)
ELABFTW_API_KEY=replace-with-your-api-key

# Optional elabFTW client tuning
# ELABFTW_VERIFY_TLS=true
# ELABFTW_TIMEOUT_MS=60000

# --- MCP Streamable HTTP (Docker / WebUI default) ---
# Host bind inside the container (compose sets 0.0.0.0)
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_PATH=/mcp

# Host port published by docker compose (maps to container 8080)
MCP_PUBLISH_PORT=8080

# false = stateful sessions (recommended for WebUI MCP clients)
# true  = one-shot transports (simpler; no session GET/DELETE)
MCP_STATELESS=false

# Optional comma-separated Host allow-list when binding 0.0.0.0
# MCP_ALLOWED_HOSTS=localhost,127.0.0.1,elabftw-mcp
