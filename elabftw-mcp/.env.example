# Base URL of the elabFTW instance (no trailing slash; /api/v2 is appended)
ELABFTW_BASE_URL=https://eln.example.org

# API key from elabFTW Settings → API keys (sent as Authorization header)
ELABFTW_API_KEY=replace-with-your-api-key

# Optional: set to "false" only for local/dev instances with self-signed certs
# ELABFTW_VERIFY_TLS=true

# Optional: request timeout in milliseconds (default 60000)
# ELABFTW_TIMEOUT_MS=60000
