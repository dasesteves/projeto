# Open WebUI ↔ OpenAI-compatible LLM (CSIC / SIU Qwen 3.8 style)
# Copy to .env and fill from your OpenCode config — never commit .env.
#
# Where to get values (on the machine where OpenCode works):
#   ~/.config/opencode/          (opencode.json / config.json)
#   ~/.local/share/opencode/     (auth.json legacy; opencode.db V2 credentials)
#   project opencode.json        (provider.options.baseURL + model id)
#   OpenCode: /connect  (stores the API key; do not paste keys into chat)
#
# Public reference matching “Qwen 3.8” + OpenCode (SIU CS AI gateway / LiteLLM):
#   base URL: https://api.cs.siu.edu/v1
#   model:    exact `id` from GET /v1/models  (display name is Qwen 3.8 27B)
# Confirm against your OpenCode provider — if CSIC uses a different gateway, use that.

# Required: OpenAI-compatible API root (must end with /v1 for most gateways)
OPENAI_API_BASE_URL=https://api.cs.siu.edu/v1

# Required: API key from OpenCode /connect (or gateway admin). Leave empty to start UI only.
OPENAI_API_KEY=

# Preferred model id after discovery (optional allowlist hint for Open WebUI)
# Example placeholder — replace with exact id from GET $OPENAI_API_BASE_URL/models
OPENAI_API_MODEL=

# Open WebUI listen port on the host
WEBUI_PORT=3000

# Local WebUI account gate (false = open local access; true = require signup/login)
WEBUI_AUTH=false

# Optional WebUI admin bootstrap (only used when WEBUI_AUTH=true)
# WEBUI_ADMIN_EMAIL=
# WEBUI_ADMIN_PASSWORD=
