# Open WebUI ↔ IIIA OpenAI-compatible LLM (OpenCode default)
# Copy to .env and fill the API key — never commit .env.
#
# Values below match David’s OpenCode hunt on his machine:
#   provider id:  iiia  (default model: iiia/default/llm)
#   base URL:     https://llm.iiia.es/v1
#   model id:     Qwen/Qwen3.8-Flash-Next
#
# Where OpenCode stores the key (do not paste keys into chat/git):
#   ~/.config/opencode/          (opencode.json / config.json)
#   ~/.local/share/opencode/     (auth.json legacy; opencode.db V2 credentials)
#   OpenCode: /connect

# Required: OpenAI-compatible API root (must end with /v1)
OPENAI_API_BASE_URL=https://llm.iiia.es/v1

# Required: API key from OpenCode /connect (provider iiia). Leave empty to start UI only.
OPENAI_API_KEY=

# Exact model id from OpenCode / GET $OPENAI_API_BASE_URL/models
OPENAI_API_MODEL=Qwen/Qwen3.8-Flash-Next

# Open WebUI listen port on the host
WEBUI_PORT=3000

# Local WebUI account gate (false = open local access; true = require signup/login)
WEBUI_AUTH=false

# Optional WebUI admin bootstrap (only used when WEBUI_AUTH=true)
# WEBUI_ADMIN_EMAIL=
# WEBUI_ADMIN_PASSWORD=
